# Plain (no-docker) ephemeral GitHub Actions runner image.
#
# Base is plain Ubuntu 26.04 LTS rather than AWS's recommended
# public.ecr.aws/lambda/microvms:al2023-minimal: the GitHub Actions runner
# tarball and its installdependencies.sh script target glibc-based
# Debian/Ubuntu userlands, and reworking that for Amazon Linux/dnf is a
# separate project. Ubuntu 26.04 is fully supported as a Lambda MicroVM
# container base image per AWS's own docs (any Linux image compatible with
# the target architecture works) - it just isn't the AWS-published minimal one.
FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive

# Pull in every pending security/bug-fix update for the packages already in
# the base image before installing anything else, so the snapshot never
# ships a base layer older than the build itself. Packages installed below
# come straight from the archive and are already current. Re-run
# scripts/03-deploy-microvm-images.sh with FORCE_REBUILD=1 to re-patch
# images whose code hasn't changed.
RUN apt-get update && \
    apt-get -y upgrade && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg tar gzip net-tools git jq unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Lambda builds the image natively on the profile's CpuConfigurations
# architecture (ARM_64 or X86_64 - see cloudformation/02-microvm-images.yaml),
# so this same Dockerfile serves both: detect the build host's architecture
# once and record the asset-name spelling each download below needs.
RUN case "$(dpkg --print-architecture)" in \
      arm64) printf 'AWSCLI_ARCH=aarch64\nRUNNER_ARCH=arm64\nPYTHON_ARCH=arm64\n' ;; \
      amd64) printf 'AWSCLI_ARCH=x86_64\nRUNNER_ARCH=x64\nPYTHON_ARCH=x64\n' ;; \
      *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac > /etc/runner-arch.env && \
    cat /etc/runner-arch.env

# Node.js 22 (NodeSource - Ubuntu's own repos only ship Node 18)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# AWS CLI v2 - workflow steps commonly invoke `aws`, and it is not present in
# the base Ubuntu image.
RUN . /etc/runner-arch.env && \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWSCLI_ARCH}.zip" -o /tmp/awscliv2.zip && \
    unzip -q /tmp/awscliv2.zip -d /tmp && \
    /tmp/aws/install && \
    rm -rf /tmp/awscliv2.zip /tmp/aws

# Bump via `docker build --build-arg RUNNER_VERSION=x.y.z` or by editing this
# default. Check https://github.com/actions/runner/releases for the latest.
ARG RUNNER_VERSION=2.338.2
WORKDIR /actions-runner

RUN . /etc/runner-arch.env && \
    curl -fsSL -O "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${RUNNER_ARCH}-${RUNNER_VERSION}.tar.gz" && \
    tar xzf "actions-runner-linux-${RUNNER_ARCH}-${RUNNER_VERSION}.tar.gz" && \
    rm "actions-runner-linux-${RUNNER_ARCH}-${RUNNER_VERSION}.tar.gz" && \
    ./bin/installdependencies.sh && \
    rm -rf /var/lib/apt/lists/*

# Pre-populate the actions/setup-python tool cache with CPython so jobs skip
# the download. AGENT_TOOLSDIRECTORY is honored both by python-versions'
# setup.sh at build time (below) and by the runner at job time, where it is
# exposed to jobs as RUNNER_TOOL_CACHE.
ENV AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache
ARG PYTHON_VERSION=3.13.18
ARG PYTHON_PLATFORM_VERSION=26.04

# Shared-library runtime deps for the prebuilt CPython stdlib (ssl/ffi/zlib
# /uuid already ship in the base image; these cover sqlite3, bz2, lzma,
# readline, curses and gdbm).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      libsqlite3-0 libbz2-1.0 liblzma5 libreadline8t64 libncursesw6 libgdbm6t64 libgdbm-compat4t64 && \
    rm -rf /var/lib/apt/lists/*

# Resolve the download URL from the python-versions manifest (avoids
# hardcoding a release id), extract, and run the bundled setup.sh, which
# installs into $AGENT_TOOLSDIRECTORY, creates the python symlinks, upgrades
# pip, and writes the completion marker actions/setup-python checks for.
RUN set -eux; \
    . /etc/runner-arch.env; \
    url="$(curl -fsSL https://raw.githubusercontent.com/actions/python-versions/main/versions-manifest.json \
      | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{const m=JSON.parse(d);const[v,pv,a]=process.argv.slice(1);const e=m.find(x=>x.version===v);if(!e){console.error("version "+v+" not in manifest");process.exit(1)}const f=e.files.find(f=>f.platform==="linux"&&f.platform_version===pv&&f.arch===a);if(!f){console.error("no matching linux build for "+v+" "+pv+" "+a);process.exit(1)}process.stdout.write(f.download_url)})' "$PYTHON_VERSION" "$PYTHON_PLATFORM_VERSION" "$PYTHON_ARCH")"; \
    echo "Downloading $url"; \
    mkdir -p /tmp/py; \
    curl -fsSL "$url" -o /tmp/py/python.tar.gz; \
    tar xzf /tmp/py/python.tar.gz -C /tmp/py; \
    ( cd /tmp/py && bash ./setup.sh ); \
    rm -rf /tmp/py

# setup.sh only installs into the tool cache; its bin/ only reaches PATH when
# a workflow runs actions/setup-python. Symlink python/pip into
# /usr/local/bin and put its bin/ on the global PATH so they work for every
# job without requiring that action (fixes "pip: command not found").
# /opt/python-default is an arch-neutral alias for the tool-cache directory
# (whose last path segment is arm64 or x64) so ENV PATH below can be static.
RUN set -eux; \
    . /etc/runner-arch.env; \
    ln -sfn "${AGENT_TOOLSDIRECTORY}/Python/${PYTHON_VERSION}/${PYTHON_ARCH}" /opt/python-default; \
    py_bin=/opt/python-default/bin; \
    ln -sf "${py_bin}/python3" /usr/local/bin/python3; \
    ln -sf "${py_bin}/python3" /usr/local/bin/python; \
    ln -sf "${py_bin}/pip3" /usr/local/bin/pip3; \
    ln -sf "${py_bin}/pip3" /usr/local/bin/pip
ENV PATH="/opt/python-default/bin:${PATH}"

COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

# Install SDK dependencies before copying app.js so this layer caches
# independently of application code changes.
COPY package.json .
RUN npm install --omit=dev --no-audit --no-fund

COPY app.js .

# The runner refuses to start as root by default; containers run as root here.
ENV RUNNER_ALLOW_RUNASROOT=1

EXPOSE 8080 9000
CMD ["node", "app.js"]
